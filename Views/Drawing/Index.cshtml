@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ScribbleRoom - Collaborative Drawing</title>
    <link rel="stylesheet" href="/css/drawing-app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="dark-theme">
    <header class="app-header">
        <div class="logo">
            <i class="fa-solid fa-paint-brush"></i>
            <h1>Scribble<span>Room</span></h1>
            <button id="toggle-ui" class="header-btn" title="Hide/Show Tools (Tab)">
                <i class="fa-solid fa-eye"></i>
            </button>
        </div>
        <div class="status">
            <span id="connection-status" class="status-indicator offline"></span>
            <span id="connection-text">Connecting...</span>
        </div>
    </header>

    <main class="canvas-viewport" id="viewport">
        <div class="canvas-wrapper" id="canvas-wrapper">
            <canvas id="drawing-canvas"></canvas>
        </div>
        
        <!-- Side Settings (Tools, Color & Size) -->
        <div class="side-panel">
            <!-- Tool Switcher -->
            <div class="tool-switcher">
                <button id="pencil-tool" class="tool-btn active" title="Pencil (B)">
                    <i class="fa-solid fa-pencil"></i>
                </button>
                <button id="eraser-tool" class="tool-btn" title="Eraser (E)">
                    <i class="fa-solid fa-eraser"></i>
                </button>
                <div class="tool-divider v"></div>
                <button id="move-tool" class="tool-btn navigate" title="Move/Zoom (H)">
                    <i class="fa-solid fa-hand"></i>
                </button>
            </div>

            <div class="setting-group color-group">
                <div class="color-wrapper">
                    <input type="color" id="color-picker" value="#3a86ff">
                </div>
                <!-- Color Palette (Pastel Template) -->
                <div class="color-palette" id="palette">
                    <div class="swatch" style="background:#ffadad" data-color="#ffadad"></div>
                    <div class="swatch" style="background:#ffd6a5" data-color="#ffd6a5"></div>
                    <div class="swatch" style="background:#fdffb6" data-color="#fdffb6"></div>
                    <div class="swatch" style="background:#caffbf" data-color="#caffbf"></div>
                    <div class="swatch" style="background:#9bf6ff" data-color="#9bf6ff"></div>
                    <div class="swatch" style="background:#a0c4ff" data-color="#a0c4ff"></div>
                    <div class="swatch" style="background:#bdb2ff" data-color="#bdb2ff"></div>
                    <div class="swatch" style="background:#ffc6ff" data-color="#ffc6ff"></div>
                    <div class="swatch" style="background:#fffffc" data-color="#fffffc"></div>
                    <div class="swatch" style="background:#8E94F2" data-color="#8E94F2"></div>
                    <div class="swatch" style="background:#2b2d42" data-color="#2b2d42"></div>
                    <div class="swatch" style="background:#ffccd5" data-color="#ffccd5"></div>
                </div>
                <!-- Hidden Palette Editor -->
                <input type="color" id="palette-editor" style="display:none">
            </div>
            
            <div class="setting-group size-group">
                <div class="vertical-slider-container">
                    <span id="size-value">5</span>
                    <input type="range" id="brush-size" min="1" max="100" value="5" orient="vertical">
                </div>
            </div>
        </div>

        <!-- Bottom Actions (Clear & Save) -->
        <div class="bottom-bar">
            <button id="clear-btn" class="icon-btn danger" title="Clear All">
                <i class="fa-solid fa-trash-can"></i>
                <span>Clear</span>
            </button>
            <div class="divider"></div>
            <button id="save-btn" class="icon-btn primary" title="Save Drawing">
                <i class="fa-solid fa-download"></i>
                <span>Save</span>
            </button>
        </div>

        <div class="navigation-hint">
            <span class="desktop-hint"><i class="fa-solid fa-mouse"></i> Space (Hold): Pan | Wheel: Zoom | Right-Click Swatch: Edit</span>
            <span class="mobile-hint"><i class="fa-solid fa-hand-pointer"></i> 2 Fingers: Zoom | Hold Swatch: Edit | 1 Finger (Hand): Pan</span>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="/js/drawing-app.js"></script>
</body>
</html>
