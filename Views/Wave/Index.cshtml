@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wave Function Simulator & Transforms</title>
    <!-- Tailwind CSS for sleek UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js for graph -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Math.js for parsing and evaluating math expressions safely -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.8.0/math.min.js"></script>
    <link rel="stylesheet" href="~/css/wave-simulator.css">
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-6 bg-gradient-to-br from-[#0f172a] via-[#1e1b4b] to-[#0f172a]">


    <div class="glass-panel p-4 sm:p-6 md:p-8 rounded-3xl md:rounded-[2.5rem] shadow-2xl w-[98vw] sm:w-[95vw] max-w-[1600px] h-auto lg:h-[92vh] flex flex-col gap-4 sm:gap-6 transition-all duration-500 lg:overflow-hidden m-2 sm:m-0">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 flex-shrink-0">
            <h1 class="text-2xl sm:text-3xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-500 tracking-tight text-center sm:text-left">
                🌊 Wave Prism
            </h1>
            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 bg-slate-900/40 p-1.5 rounded-2xl border border-slate-700/50 backdrop-blur-sm w-full sm:w-auto">
                <select id="analysisType" class="bg-transparent border-none px-2 sm:px-4 py-2 text-white outline-none font-mono text-xs sm:text-sm cursor-pointer hover:text-cyan-400 transition-colors flex-grow sm:flex-grow-0">
                    <option value="time" class="bg-slate-900">Time Domain f(t)</option>
                    <option value="fourier" class="bg-slate-900">Fourier Transform |F(ω)|</option>
                    <option value="freq_mag" class="bg-slate-900">Freq Response (Mag dB)</option>
                    <option value="freq_phase" class="bg-slate-900">Freq Response (Phase)</option>
                    <option value="laplace" class="bg-slate-900">Laplace Transform F(s) (Real)</option>
                </select>
                <button id="simulateBtn" class="bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-2 sm:py-2.5 px-4 sm:px-8 rounded-xl shadow-lg shadow-cyan-500/20 transition-all transform active:scale-95 flex items-center gap-2 text-xs sm:text-sm">
                    <span>🚀</span> <span class="hidden xs:inline">Run</span>
                </button>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 flex-grow lg:overflow-hidden pb-4 sm:pb-0">
            <!-- Left Side: Inputs -->
            <div class="lg:col-span-4 xl:col-span-3 space-y-4 sm:space-y-6 flex flex-col lg:h-full lg:overflow-hidden order-2 lg:order-1">
                <div class="flex-grow flex flex-col lg:overflow-hidden">
                    <label class="block text-[10px] sm:text-xs font-bold mb-3 sm:mb-4 text-slate-500 uppercase tracking-widest flex justify-between items-center flex-shrink-0">
                        Signal Inputs
                        <button id="addFuncBtn" class="text-xs text-cyan-400 hover:text-cyan-300 flex items-center gap-1.5 bg-cyan-400/10 px-2 sm:px-3 py-1 sm:py-1.5 rounded-lg transition-all border border-cyan-400/20">
                            <span class="text-sm sm:text-lg font-bold">+</span> NEW
                        </button>
                    </label>
                    <div id="functionsContainer" class="max-h-[300px] lg:max-h-none lg:flex-grow overflow-y-auto pr-3 custom-scrollbar space-y-3 sm:space-y-4 pb-2">
                        <!-- Function Rows will be added here -->
                    </div>
                </div>

                <!-- Range Controls -->
                <div class="bg-slate-900/60 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-white/5 space-y-4 sm:space-y-5 flex-shrink-0">
                    <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em]">Simulation Box</h3>
                    <div class="grid grid-cols-3 gap-2 sm:gap-3">
                        <div class="space-y-1.5">
                            <label class="block text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-wider" id="lblMin">Min (t)</label>
                            <input type="number" id="xMin" value="0" step="0.1" class="w-full bg-slate-800/80 border border-slate-700/50 rounded-xl px-2 sm:px-3 py-2 sm:py-2.5 text-white outline-none focus:border-cyan-500/40 transition-all text-xs sm:text-sm">
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-wider" id="lblMax">Max (t)</label>
                            <input type="number" id="xMax" value="10" step="0.1" class="w-full bg-slate-800/80 border border-slate-700/50 rounded-xl px-2 sm:px-3 py-2 sm:py-2.5 text-white outline-none focus:border-cyan-500/40 transition-all text-xs sm:text-sm">
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-wider">Step</label>
                            <input type="number" id="step" value="0.05" step="0.01" class="w-full bg-slate-800/80 border border-slate-700/50 rounded-xl px-2 sm:px-3 py-2 sm:py-2.5 text-white outline-none focus:border-cyan-500/40 transition-all text-xs sm:text-sm">
                        </div>
                    </div>

                    <!-- Amplitude Controls -->
                    <div class="space-y-3 pt-3 sm:pt-4 border-t border-white/5">
                        <div class="flex items-center justify-between">
                            <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em]">Amplitude (Y)</h3>
                            <label class="flex items-center gap-2 text-[10px] text-slate-400 font-bold uppercase cursor-pointer group">
                                <input type="checkbox" id="autoY" checked class="w-3 h-3 accent-cyan-500"> 
                                <span class="group-hover:text-cyan-400 transition-colors">AUTO</span>
                            </label>
                        </div>
                        <div id="yControlRow" class="grid grid-cols-2 gap-2 sm:gap-3 opacity-40 pointer-events-none transition-all duration-300">
                            <div class="space-y-1.5">
                                <label class="block text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-wider">Min Amp</label>
                                <input type="number" id="yMin" value="-2" step="0.5" class="w-full bg-slate-800/80 border border-slate-700/50 rounded-xl px-2 sm:px-3 py-1.5 sm:py-2 text-white outline-none focus:border-cyan-500/40 transition-all text-xs sm:text-sm">
                            </div>
                            <div class="space-y-1.5">
                                <label class="block text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-wider">Max Amp</label>
                                <input type="number" id="yMax" value="2" step="0.5" class="w-full bg-slate-800/80 border border-slate-700/50 rounded-xl px-2 sm:px-3 py-1.5 sm:py-2 text-white outline-none focus:border-cyan-500/40 transition-all text-xs sm:text-sm">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Graph -->
            <div class="lg:col-span-8 xl:col-span-9 h-full min-h-[300px] sm:min-h-[400px] order-1 lg:order-2">
                <div class="bg-black/20 backdrop-blur-sm p-4 sm:p-6 md:p-8 rounded-2xl sm:rounded-[2.5rem] border border-white/5 w-full h-full relative group">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent"></div>
                    <canvas id="waveChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/wave-simulator.js"></script>
</body>
</html>
