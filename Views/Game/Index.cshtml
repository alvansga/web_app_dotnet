@model MyFirstApp.Models.HangmanGame
@{ Layout = null; }
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hangman Game</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap');
        
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: #ffffff;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
            text-align: center;
            max-width: 500px;
            width: 100%;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 20px;
            font-weight: 800;
            letter-spacing: 2px;
            color: #4facfe;
        }

        .word-display {
            font-size: 3em;
            letter-spacing: 15px;
            margin: 30px 0;
            font-family: monospace;
            text-transform: uppercase;
        }

        .status {
            font-size: 1.2em;
            margin-bottom: 30px;
            color: #b2bec3;
        }

        .input-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        input[type="text"] {
            padding: 15px;
            font-size: 1.5em;
            width: 60px;
            text-align: center;
            border: 2px solid #4facfe;
            background: transparent;
            color: white;
            border-radius: 12px;
            text-transform: uppercase;
            outline: none;
            transition: all 0.3s ease;
        }

        input[type="text"]:focus {
            box-shadow: 0 0 15px #4facfe;
        }

        button {
            padding: 15px 30px;
            font-size: 1.2em;
            font-weight: 600;
            cursor: pointer;
            border: none;
            border-radius: 12px;
            background: linear-gradient(to right, #4facfe 0%, #00f2fe 100%);
            color: white;
            transition: transform 0.2s, box-shadow 0.2s;
            font-family: 'Outfit', sans-serif;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(79, 172, 254, 0.4);
        }

        .alert {
            padding: 20px;
            border-radius: 12px;
            font-size: 1.5em;
            font-weight: 600;
            margin-bottom: 20px;
            animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .alert-success {
            background: rgba(46, 213, 115, 0.2);
            border: 1px solid #2ed573;
            color: #2ed573;
        }

        .alert-danger {
            background: rgba(255, 71, 87, 0.2);
            border: 1px solid #ff4757;
            color: #ff4757;
        }

        .reset-form {
            margin-top: 20px;
        }

        .reset-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .reset-btn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        @@keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>HANGMAN</h1>
        
        <div class="status">
            Salah: <strong>@Model.WrongAttempts()</strong> / @Model.MaxAttempts
        </div>

        <div class="word-display">
            @Model.GetMaskedWord()
        </div>

        @if (Model.IsWon())
        {
            <div class="alert alert-success">
                🎉 Yeay, Kamu Menang!
            </div>
        }
        else if (Model.IsLost())
        {
            <div class="alert alert-danger">
                💀 Kalah! Kata: @Model.Word.ToUpper()
            </div>
        }
        else
        {
            <form method="post" action="/Game/Guess">
                <div class="input-group">
                    <input type="text" name="letter" maxlength="1" required autocomplete="off" autofocus />
                    <button type="submit">Tebak</button>
                </div>
            </form>
        }

        @if (Model.IsWon() || Model.IsLost())
        {
            <form method="post" action="/Game/Reset" class="reset-form">
                <button type="submit" class="reset-btn">Main Lagi</button>
            </form>
        }
    </div>
</body>
</html>