@model MyFirstApp.Models.CoupGame
@{ Layout = null; }
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Coup Game Sederhana</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #2c3e50; color: #ecf0f1; margin: 0; padding: 20px; }
        .container { max-width: 800px; margin: 0 auto; background: #34495e; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        h1, h2 { color: #f1c40f; text-align: center; }
        .log-box { background: #1abc9c; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold; }
        .card-container { display: flex; flex-wrap: wrap; gap: 15px; justify-content: center; }
        .player-card { background: #2c3e50; border: 2px solid #bdc3c7; border-radius: 8px; padding: 15px; width: 220px; position: relative; }
        .player-card.active { border-color: #e74c3c; box-shadow: 0 0 15px #e74c3c; }
        .player-card.dead { opacity: 0.5; border-color: #7f8c8d; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 0.8em; margin-right: 5px; }
        .badge.coin { background: #f1c40f; color: #2c3e50; font-weight: bold; }
        .badge.influence { background: #3498db; color: white; }
        .badge.revealed { background: #e74c3c; color: white; text-decoration: line-through; }
        .btn { padding: 10px 15px; border: none; border-radius: 5px; cursor: pointer; color: white; font-weight: bold; margin: 5px; }
        .btn-green { background: #2ecc71; } .btn-green:hover { background: #27ae60; }
        .btn-blue { background: #3498db; } .btn-blue:hover { background: #2980b9; }
        .btn-red { background: #e74c3c; } .btn-red:hover { background: #c0392b; }
        .btn-yellow { background: #f1c40f; color: #2c3e50; } .btn-yellow:hover { background: #f39c12; }
        .action-panel { background: #e74c3c; padding: 15px; border-radius: 8px; margin-top: 20px; text-align: center; }
        .form-group { margin-bottom: 10px; }
        input[type="text"] { padding: 8px; width: calc(100% - 20px); border-radius: 4px; border: none; margin-bottom: 10px; }
        select { padding: 8px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Coup Card Game 🎭</h1>
        
        <div class="log-box">Log: @Model.Log</div>

        @{
            var currentPlayer = Model.Players.Count > 0 && Model.CurrentTurnIndex < Model.Players.Count ? Model.Players[Model.CurrentTurnIndex] : null;
            var isMyTurn = (currentPlayer != null && currentPlayer.Id == (string)ViewBag.MyPlayerId);
        }

        @if (Model.GameState == "Lobby")
        {
            @if (ViewBag.MyPlayerId == null)
            {
                <h2>Lobby - Join Game</h2>
                <form method="post" action="/Coup/AddPlayer" style="text-align:center;">
                    <div style="margin-bottom:15px;">
                        <input type="text" name="name" placeholder="Siapa namamu?" required style="padding:12px; font-size:1.1em; border-radius:8px; border:2px solid #1abc9c;" />
                    </div>
                    <div>
                        <input type="text" name="description" placeholder="Catatan kecil (misal: Sang Penipu)" style="padding:8px; width:300px; border-radius:5px;" />
                    </div>
                    <br>
                    <button type="submit" class="btn btn-green" style="padding: 12px 30px; font-size:1.2em;">Join as New Player</button>
                    <p style="color:#bdc3c7; font-size:0.9em; margin-top:10px;">(Buka tab baru di browser lain / incognito untuk main sebagai orang lain)</p>
                </form>
            }
            else
            {
                var me = Model.Players.FirstOrDefault(p => p.Id == (string)ViewBag.MyPlayerId);
                <div style="text-align:center; padding:20px; border: 2px dashed #f1c40f; border-radius:10px; margin-bottom:20px;">
                    <h2 style="margin-top:0;">Halo, @(me?.Name ?? "Pemain")! 👋</h2>
                    <p>Kamu sudah terdaftar. Menunggu pemain lain atau mulai game jika sudah cukup.</p>
                </div>
            }

            @if (Model.Players.Count > 0)
            {
                <h3>Pemain di Lobby (@Model.Players.Count)</h3>
                <div style="display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:20px;">
                    @foreach (var p in Model.Players)
                    {
                        <div style="background:#2c3e50; padding:10px 20px; border-radius:30px; border: 2px solid @(p.Id == (string)ViewBag.MyPlayerId ? "#f1c40f" : "#7f8c8d")">
                            @p.Name @(p.Id == (string)ViewBag.MyPlayerId ? "(Anda)" : "")
                        </div>
                    }
                </div>
            }

            @if (Model.Players.Count >= 2 && ViewBag.MyPlayerId != null)
            {
                <form method="post" action="/Coup/Start" style="text-align:center; margin-top:20px;">
                    <button type="submit" class="btn btn-blue" style="font-size: 1.1em;">Start the Game! 🚀</button>
                </form>
            }
        }
        else
        {
            <h2>Giliran: @(currentPlayer?.Name ?? "...") @(isMyTurn ? " (GILIRAN ANDA!)" : "")</h2>

            <div class="card-container">
                @for (int i = 0; i < Model.Players.Count; i++)
                {
                    var p = Model.Players[i];
                    var isMe = p.Id == (string)ViewBag.MyPlayerId;
                    var isActive = (i == Model.CurrentTurnIndex && !p.IsDead) ? "active" : "";
                    var isDead = p.IsDead ? "dead" : "";

                    <div class="player-card @isActive @isDead" style="@(isMe ? "border-width:4px; border-style:dashed; border-color:#f1c40f;" : "")">
                        @if (isMe) { <div style="position:absolute; top:-10px; right:-10px; background:#f1c40f; color:#2c3e50; padding:2px 8px; border-radius:5px; font-weight:bold; font-size:0.8em;">ANDA</div> }
                        <h3>@p.Name</h3>
                        <p style="font-size:0.8em; margin-top:-10px;">@p.Description</p>
                        <div>
                            <span class="badge coin">🪙 @p.Coins Coins</span>
                        </div>
                        <div style="margin-top: 10px;">
                            <strong>Kartu/Influence:</strong><br>
                            @if (isMe)
                            {
                                @foreach (var card in p.Hand)
                                {
                                    <span class="badge influence" style="background:#27ae60;">@card</span>
                                }
                            }
                            else
                            {
                                @foreach (var card in p.Hand)
                                {
                                    <span class="badge influence">Sembunyi</span>
                                }
                            }
                            @foreach (var card in p.Revealed)
                            {
                                <span class="badge revealed">@card</span>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (Model.GameState == "Playing")
            {
                var cp = Model.Players[Model.CurrentTurnIndex];
                
                @if (isMyTurn)
                {
                    <div class="action-panel" style="border: 4px solid #f1c40f;">
                        <h3>Action untuk @cp.Name (Giliran Anda)</h3>
                        <form method="post" action="/Coup/Action" style="display:inline-block;">
                            <input type="hidden" name="type" value="Income" />
                            <button type="submit" class="btn btn-blue">Income (+1 🪙)</button>
                        </form>
                        
                        <form method="post" action="/Coup/Action" style="display:inline-block;">
                            <input type="hidden" name="type" value="ForeignAid" />
                            <button type="submit" class="btn btn-blue">Foreign Aid (+2 🪙)</button>
                        </form>

                        <form method="post" action="/Coup/Action" style="display:inline-block;">
                            <input type="hidden" name="type" value="Tax" />
                            <button type="submit" class="btn btn-yellow">Tax / Duke (+3 🪙)</button>
                        </form>

                        @if (cp.Coins >= 7)
                        {
                            <form method="post" action="/Coup/Action" style="display:inline-block; margin-top:10px;">
                                <input type="hidden" name="type" value="Coup" />
                                <select name="targetId" required style="padding:10px; border-radius:5px;">
                                    <option value="">-- Pilih Target Coup --</option>
                                    @foreach (var p in Model.Players.Where(x => !x.IsDead && x.Id != cp.Id))
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-red">⚔️ COUP (-7 🪙)</button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <div class="action-panel" style="background: #34495e; border: 1px solid #7f8c8d;">
                        <h3>Menunggu @cp.Name melakukan aksi...</h3>
                        <p style="font-style:italic;">Hanya pemain yang sedang giliran yang bisa beraksi.</p>
                    </div>
                }
            }

            <form method="post" action="/Coup/Reset" style="text-align:center; margin-top:30px;">
                <button type="submit" class="btn btn-red">Reset Game & Kembali ke Lobby</button>
            </form>
        }

        <script>
            // Auto refresh halaman setiap 2 detik jika bukan giliran kita atau game di lobby.
            // Biar bisa lihat kalau musuh sudah gerak.
            var isMyTurn = "@isMyTurn".toLowerCase() === "true";
            var gameState = "@Model.GameState";

            if (!isMyTurn || gameState === "Lobby") {
                setTimeout(function() {
                    // Cek kalau user lagi gak ngetik di input
                    if (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
                        location.reload();
                    }
                }, 2000);
            }
        </script>
    </div>
</body>
</html>
