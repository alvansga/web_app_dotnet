@model WebAppSandbox.Models.CoupGame
@{ Layout = null; }
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coup Game Sederhana (SignalR)</title>
    <!-- Include SignalR Client Library from CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #2c3e50; color: #ecf0f1; margin: 0; padding: 10px; }
        .container { 
            width: 100%;
            max-width: 900px; 
            margin: 0 auto; 
            background: #34495e; 
            padding: 15px; 
            border-radius: 12px; 
            box-shadow: 0 10px 25px rgba(0,0,0,0.5); 
            box-sizing: border-box;
        }
        h1 { font-size: 1.8rem; }
        h2 { color: #f1c40f; text-align: center; font-size: 1.4rem; }
        .log-box { background: #1abc9c; color: white; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-weight: bold; font-size: 0.9rem; word-break: break-word; }
        .card-container { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
        .player-card { 
            background: #2c3e50; 
            border: 2px solid #bdc3c7; 
            border-radius: 8px; 
            padding: 12px; 
            width: 180px; 
            position: relative; 
            box-sizing: border-box;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .player-card.active { border-color: #e74c3c; box-shadow: 0 0 15px rgba(231, 76, 60, 0.4); transform: scale(1.02); }
        .player-card.dead { opacity: 0.4; border-color: #7f8c8d; filter: grayscale(1); }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; margin-right: 5px; margin-bottom: 5px; }
        .badge.coin { background: #f1c40f; color: #2c3e50; font-weight: bold; }
        .badge.influence { background: #3498db; color: white; }
        .badge.revealed { background: #e74c3c; color: white; text-decoration: line-through; }
        .btn { padding: 12px 18px; border: none; border-radius: 8px; cursor: pointer; color: white; font-weight: bold; margin: 5px; font-size: 1rem; -webkit-tap-highlight-color: transparent; }
        .btn-green { background: #2ecc71; } .btn-green:hover { background: #27ae60; }
        .btn-blue { background: #3498db; } .btn-blue:hover { background: #2980b9; }
        .btn-red { background: #e74c3c; } .btn-red:hover { background: #c0392b; }
        .btn-yellow { background: #f1c40f; color: #2c3e50; } .btn-yellow:hover { background: #f39c12; }
        .action-panel { background: #e74c3c; padding: 15px; border-radius: 12px; margin-top: 20px; text-align: center; }
        input[type="text"] { padding: 12px; border-radius: 6px; border: 1px solid #7f8c8d; width: 100%; max-width: 400px; box-sizing: border-box; margin-bottom: 10px; font-size: 1rem; }
        select { padding: 10px; border-radius: 6px; font-size: 1rem; margin-bottom: 10px; width: 100%; max-width: 400px; }
        #game-container { transition: opacity 0.2s; }

        /* Media Queries for Mobile/Tablet */
        @@media (max-width: 600px) {
            .player-card { width: calc(50% - 10px); min-width: 140px; padding: 10px; }
            h1 { font-size: 1.5rem; }
            h2 { font-size: 1.2rem; }
            .btn { width: 100%; max-width: none; box-sizing: border-box; }
            .card-container { gap: 8px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Coup Card Game</h1>
        
        <div id="game-container">
            @await Html.PartialAsync("_GameContent", Model)
        </div>

        <script>
            // Setup SignalR connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/gameHub")
                .build();

            // Refresh game board via AJAX (same logic as before, but triggered by server)
            async function refreshGame() {
                try {
                    const response = await fetch('/Coup/GamePartial');
                    if (response.ok) {
                        const html = await response.text();
                        const container = document.getElementById('game-container');
                        container.innerHTML = html;
                        
                        // Execute internal scripts
                        const scripts = container.querySelectorAll('script');
                        scripts.forEach(s => eval(s.innerHTML));
                    }
                } catch (err) {
                    console.error("SignalR Refresh Error:", err);
                }
            }

            // Listen for server notifications
            connection.on("ReceiveUpdate", () => {
                console.log("ReceiveUpdate: Refreshing board...");
                refreshGame();
            });

            // Start connection
            connection.start().then(() => {
                console.log("SignalR Connected!");
            }).catch(err => console.error("SignalR Connection Failed: ", err));

            // Optional: fallback periodik jika SignalR putus
            // setInterval(refreshGame, 10000);
        </script>
    </div>
</body>
</html>
