@model WebAppSandbox.Models.CoupGame
<div class="log-box">Log: @Model.Log</div>

@{
    var currentPlayer = Model.Players.Count > 0 && Model.CurrentTurnIndex < Model.Players.Count ? Model.Players[Model.CurrentTurnIndex] : null;
    var isMyTurn = (currentPlayer != null && currentPlayer.Id == (string)ViewBag.MyPlayerId);
    var myId = (string)ViewBag.MyPlayerId;
}

@if (Model.GameState == "Lobby")
{
    @if (myId == null)
    {
        <h2>Lobby - Join Game</h2>
        <form method="post" action="/Coup/AddPlayer" style="text-align:center;">
            <div style="margin-bottom:15px;">
                <input type="text" name="name" placeholder="Siapa namamu?" required style="padding:12px; font-size:1.1em; border-radius:8px; border:2px solid #1abc9c;" />
            </div>
            <div>
                <input type="text" name="description" placeholder="Catatan kecil (misal: Sang Penipu)" style="padding:8px; width:300px; border-radius:5px;" />
            </div>
            <br>
            <button type="submit" class="btn btn-green" style="padding: 12px 30px; font-size:1.2em;">Join as New Player</button>
            <p style="color:#bdc3c7; font-size:0.9em; margin-top:10px;">(Buka tab baru atau browser lain untuk main bersama)</p>
        </form>
    }
    else
    {
        var me = Model.Players.FirstOrDefault(p => p.Id == myId);
        <div style="text-align:center; padding:20px; border: 2px dashed #f1c40f; border-radius:10px; margin-bottom:20px;">
            <h2 style="margin-top:0;">Halo, @(me?.Name ?? "Pemain")! 👋</h2>
            <p>Kamu sudah terdaftar. Menunggu pemain lain atau mulai game jika sudah cukup.</p>
        </div>
    }

    @if (Model.Players.Count > 0)
    {
        <h3>Pemain di Lobby (@Model.Players.Count)</h3>
        <div style="display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:20px;">
            @foreach (var p in Model.Players)
            {
                <div style="background:#2c3e50; padding:10px 20px; border-radius:30px; border: 2px solid @(p.Id == myId ? "#f1c40f" : "#7f8c8d")">
                    @p.Name @(p.Id == myId ? "(Anda)" : "")
                </div>
            }
        </div>
    }

    @if (Model.Players.Count >= 2 && myId != null)
    {
        <form method="post" action="/Coup/Start" style="text-align:center; margin-top:20px;">
            <button type="submit" class="btn btn-blue" style="font-size: 1.1em;">Start the Game! 🚀</button>
        </form>
    }
}
else
{
    var turnHeader = Model.GameState == "WaitingForChallenge" ? "Menunggu Challenge..." : (isMyTurn ? "GILIRAN ANDA!" : $"Giliran {currentPlayer?.Name}");
    
    <h2>@turnHeader</h2>

    <div class="card-container">
        @for (int i = 0; i < Model.Players.Count; i++)
        {
            var p = Model.Players[i];
            var isMe = p.Id == myId;
            var isActive = (i == Model.CurrentTurnIndex && !p.IsDead) ? "active" : "";
            var isDead = p.IsDead ? "dead" : "";

            <div class="player-card @isActive @isDead" style="@(isMe ? "border-width:4px; border-style:dashed; border-color:#f1c40f;" : "")">
                @if (isMe) { <div style="position:absolute; top:-10px; right:-10px; background:#f1c40f; color:#2c3e50; padding:2px 8px; border-radius:5px; font-weight:bold; font-size:0.8em;">ANDA</div> }
                <h3>@p.Name</h3>
                <p style="font-size:0.8em; margin-top:-10px;">@p.Description</p>
                <div>
                    <span class="badge coin">🪙 @p.Coins Coins</span>
                </div>
                <div style="margin-top: 10px;">
                    <strong>Influences:</strong><br>
                    @if (isMe)
                    {
                        @foreach (var card in p.Hand)
                        {
                            <span class="badge influence" style="background:#27ae60;">@card</span>
                        }
                    }
                    else
                    {
                        @foreach (var card in p.Hand)
                        {
                            <span class="badge influence">Tersembunyi</span>
                        }
                    }
                    @foreach (var card in p.Revealed)
                    {
                        <span class="badge revealed">@card</span>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.GameState == "Playing" && isMyTurn)
    {
        <div class="action-panel" style="border: 4px solid #f1c40f; background: #2c3e50; color: white;">
            <h3>Aksi untuk Anda (@currentPlayer?.Name)</h3>
            
            <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 5px;">
                @* Aksi Dasar *@
                <form method="post" action="/Coup/Action"><input type="hidden" name="type" value="Income" /><button type="submit" class="btn btn-blue">Income (+1)</button></form>
                <form method="post" action="/Coup/Action"><input type="hidden" name="type" value="ForeignAid" /><button type="submit" class="btn btn-blue">Foreign Aid (+2)</button></form>
                
                @* Aksi Peran *@
                <form method="post" action="/Coup/Action"><input type="hidden" name="type" value="Tax" /><button type="submit" class="btn btn-yellow">Tax (Duke)</button></form>
                <form method="post" action="/Coup/Action"><input type="hidden" name="type" value="Exchange" /><button type="submit" class="btn btn-yellow">Exchange (Ambassador)</button></form>
                
                @if (currentPlayer?.Coins >= 3) {
                   <form method="post" action="/Coup/Action" style="display:flex; align-items:center;">
                        <input type="hidden" name="type" value="Assassinate" />
                        <select name="targetId" required style="width:100px;">
                            @foreach (var p in Model.Players.Where(x => !x.IsDead && x.Id != myId)) { <option value="@p.Id">@p.Name</option> }
                        </select>
                        <button type="submit" class="btn btn-red">Assassinate (-3)</button>
                    </form>
                }

                <form method="post" action="/Coup/Action" style="display:flex; align-items:center;">
                    <input type="hidden" name="type" value="Steal" />
                    <select name="targetId" required style="width:100px;">
                        @foreach (var p in Model.Players.Where(x => !x.IsDead && x.Id != myId)) { <option value="@p.Id">@p.Name</option> }
                    </select>
                    <button type="submit" class="btn btn-yellow">Steal (Captain)</button>
                </form>

                @if (currentPlayer?.Coins >= 7) {
                    <form method="post" action="/Coup/Action">
                        <input type="hidden" name="type" value="Coup" />
                        <select name="targetId" required style="width:100px;">
                            @foreach (var p in Model.Players.Where(x => !x.IsDead && x.Id != myId)) { <option value="@p.Id">@p.Name</option> }
                        </select>
                        <button type="submit" class="btn btn-red">⚔️ COUP (-7)</button>
                    </form>
                }
            </div>
        </div>
    }

    @if ((Model.GameState == "WaitingForChallenge" || Model.GameState == "WaitingForBlockChallenge") && Model.PendingAction != null)
    {
        var pa = Model.PendingAction;
        var subjectId = Model.GameState == "WaitingForChallenge" ? pa.SourceId : pa.BlockingPlayerId;
        var subjectPlayer = Model.Players.FirstOrDefault(p => p.Id == subjectId);
        var role = Model.GameState == "WaitingForChallenge" ? pa.ClaimedRole : pa.BlockClaimedRole;
        
        <div class="action-panel" style="background: #e67e22; border: 4px solid #d35400;">
            <h3>📢 CHALLENGE PHASE!</h3>
            <p><strong>@subjectPlayer?.Name</strong> mengklaim peran <strong>@role</strong>.</p>
            
            @if (myId != null && myId != subjectId)
            {
                var passes = Model.GameState == "WaitingForChallenge" ? pa.PlayersPassedChallenge : pa.PlayersPassedBlockChallenge;
                @if (passes.Contains(myId))
                {
                    <p style="color:#2ecc71;">✅ Anda sudah setuju.</p>
                }
                else
                {
                    <div style="display:flex; justify-content:center; gap:10px;">
                        <form method="post" action="/Coup/SubmitChallenge"><button type="submit" class="btn btn-red">🔍 CHALLENGE!</button></form>
                        <form method="post" action="/Coup/Pass"><button type="submit" class="btn btn-green">✅ PASS / OK</button></form>
                    </div>
                }
            }
            else
            {
                <p style="font-style:italic;">Menunggu respon pemain lain...</p>
            }
        </div>
    }

    @if (Model.GameState == "WaitingForBlock" && Model.PendingAction != null)
    {
        var pa = Model.PendingAction;
        var canBlock = (pa.ActionType == "ForeignAid") || (myId == pa.TargetId);
        
        <div class="action-panel" style="background: #2980b9; border: 4px solid #3498db;">
            <h3>🛡️ BLOCK PHASE!</h3>
            <p>Aksi <strong>@pa.ActionType</strong> sedang diproses. @(canBlock ? "Apakah Anda ingin melakukan BLOCK?" : "Hanya target yang bisa menghalangi.")</p>
            
            @if (canBlock)
            {
                <div style="display:flex; justify-content:center; gap:5px; flex-wrap:wrap;">
                    @if (pa.ActionType == "ForeignAid") {
                       <form method="post" action="/Coup/Block"><input type="hidden" name="role" value="Duke" /><button type="submit" class="btn btn-yellow">Block with Duke</button></form>
                    }
                    @if (pa.ActionType == "Assassinate") {
                       <form method="post" action="/Coup/Block"><input type="hidden" name="role" value="Contessa" /><button type="submit" class="btn btn-yellow">Block with Contessa</button></form>
                    }
                    @if (pa.ActionType == "Steal") {
                       <form method="post" action="/Coup/Block"><input type="hidden" name="role" value="Captain" /><button type="submit" class="btn btn-yellow">Block with Captain</button></form>
                       <form method="post" action="/Coup/Block"><input type="hidden" name="role" value="Ambassador" /><button type="submit" class="btn btn-yellow">Block with Ambassador</button></form>
                    }
                    <form method="post" action="/Coup/PassBlock"><button type="submit" class="btn btn-green">Allow Action</button></form>
                </div>
            }
            else
            {
                <p style="font-style:italic;">Menunggu respon dari target (@(Model.Players.FirstOrDefault(x => x.Id == pa.TargetId)?.Name ?? "semua")...</p>
            }
        </div>
    }

    <div style="text-align:center; margin-top:30px; border-top: 1px solid #7f8c8d; padding-top: 20px;">
        <form method="post" action="/Coup/Reset" onsubmit="return confirm('Apakah Anda yakin ingin meriset game? Semua progres pemain akan hilang.');">
            <button type="submit" class="btn btn-red" style="opacity: 0.8;">⚠️ Reset Game </button>
        </form>

        <details style="margin-top: 20px; background: #2c3e50; border-radius: 8px; overflow: hidden; border: 1px solid #7f8c8d;">
            <summary style="padding: 15px; cursor: pointer; font-weight: bold; background: #34495e; color: #f1c40f;">
                📖 Manual 
            </summary>
            <div style="padding: 15px; overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9em; text-align: left;">
                    <thead>
                        <tr style="border-bottom: 2px solid #7f8c8d; color: #1abc9c;">
                            <th style="padding: 8px;">Karakter</th>
                            <th style="padding: 8px;">Aksi</th>
                            <th style="padding: 8px;">Efek</th>
                            <th style="padding: 8px;">Bisa Di-Block Oleh</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border-bottom: 1px solid #3d5a75;">
                            <td><b>Duke</b></td>
                            <td>Tax</td>
                            <td>Ambil 3 koin</td>
                            <td>-</td>
                        </tr>
                        <tr style="border-bottom: 1px solid #3d5a75;">
                            <td><b>Assassin</b></td>
                            <td>Assassinate</td>
                            <td>Bayar 3 koin, pilih target mati</td>
                            <td>Contessa</td>
                        </tr>
                        <tr style="border-bottom: 1px solid #3d5a75;">
                            <td><b>Captain</b></td>
                            <td>Steal</td>
                            <td>Ambil 2 koin dari musuh</td>
                            <td>Captain / Ambassador</td>
                        </tr>
                        <tr style="border-bottom: 1px solid #3d5a75;">
                            <td><b>Ambassador</b></td>
                            <td>Exchange</td>
                            <td>Tukar kartu dengan Deck</td>
                            <td>-</td>
                        </tr>
                        <tr style="border-bottom: 1px solid #3d5a75;">
                            <td><b>Contessa</b></td>
                            <td>-</td>
                            <td>(Pasif)</td>
                            <td>Blokir Assassin</td>
                        </tr>
                        <tr style="background: rgba(255,255,255,0.05);">
                            <td>Umum</td>
                            <td>Foreign Aid</td>
                            <td>Ambil 2 koin</td>
                            <td>Duke</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </details>
    </div>
}

<script>
    window.isMyTurn = @(isMyTurn.ToString().ToLower());
    window.gameState = "@Model.GameState";
</script>
